# On the Kindle: one gzip member per frame, from the buffer on screen.
REMOTE_GRAB = r"""
F=/sys/class/graphics/fb0
S=$(cat $F/stride); W=${S}; H=$(cut -d, -f2 $F/virtual_size); B=$(cat $F/bits_per_pixel)
X=$(cut -d, -f1 $F/virtual_size)
V=$(cat $F/modes | sed -n 's/.*:\([0-9]*\)x\([0-9]*\).*/\2/p'); [ -n "$V" ] && H=$V
echo "KINDLE-FB $X $H $S $B"
while :; do
  off=$(cut -d, -f2 $F/pan)
  dd if=/dev/fb0 bs=$S skip=$off count=$H 2>/dev/null | gzip -1
  usleep DELAY 2>/dev/null || sleep 1
done
"""


def png_gray(w, h, raw):
    def chunk(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
    rows = b"".join(b"\0" + raw[y * w:(y + 1) * w] for y in range(h))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 0, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(rows, 1)) + chunk(b"IEND", b""))


class Screen:
    def __init__(self):
        self.cv = threading.Condition()
        self.png = None
        self.id = 0
        self.live = False
        self.digest = None

    def put(self, w, h, stride, raw):
        d = hashlib.blake2b(raw, digest_size=16).digest()
        with self.cv:
            self.live = True
            if d == self.digest:
                return
        if stride != w:
            raw = b"".join(raw[y * stride:y * stride + w] for y in range(h))
        png = png_gray(w, h, raw)
        with self.cv:
            self.digest, self.png, self.id = d, png, self.id + 1
            self.cv.notify_all()

    def offline(self):
        with self.cv:
            self.live = False
            self.cv.notify_all()


def feed_stream(screen, stream, head):
    """Reads frames (one gzip member each, after a "KINDLE-FB w h stride bpp" line) into screen."""
    w, h, stride, bpp = map(int, head[-4:])
    if bpp != 8:
        raise OSError(f"tela de {bpp} bits não suportada")
    print(f"Kindle conectado: tela {w}x{h}", flush=True)
    size = stride * h
    buf = bytearray()
    dec = zlib.decompressobj(31)
    while True:
        chunk = stream.read1(65536) if hasattr(stream, "read1") else stream.read(65536)
        if not chunk:
            return
        while chunk:
            buf += dec.decompress(chunk)
            if dec.eof:
                chunk = dec.unused_data
                dec = zlib.decompressobj(31)
            else:
                chunk = b""
        while len(buf) >= size:
            frame = bytes(buf[:size])
            del buf[:size]
            screen.put(w, h, stride, frame)


def grab_loop(screen, fps):
    delay = max(50_000, int(1_000_000 / fps))
    while True:
        p = subprocess.Popen(ssh_cmd(REMOTE_GRAB.replace("DELAY", str(delay))), stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL)
        try:
            head = p.stdout.readline().decode().split()
            if len(head) != 5 or head[0] != "KINDLE-FB":
                raise OSError("sem resposta")
            feed_stream(screen, p.stdout, head)
        except OSError as e:
            print(f"Kindle: {e}", flush=True)
        finally:
            p.kill()
        screen.offline()
        print("sem sinal do Kindle; tentando de novo em 3 s…", flush=True)
        time.sleep(3)


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def obs_server(screen, port, girar=0, inverter=False, fundo="#000000"):
    """The page for OBS's browser source, on this Mac only."""
    page = (PAGE.replace("BG", fundo.lstrip("#")).replace("ROT", str(girar))
            .replace("FILTER", "filter:invert(1)" if inverter else ""))

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            if self.path.startswith("/frame.png"):
                m = re.search(r"after=(\d+)", self.path)
                after = int(m.group(1)) if m else -1
                with screen.cv:
                    screen.cv.wait_for(lambda: screen.id != after, timeout=10)
                    png, fid, live = screen.png, screen.id, screen.live
                if png is None or fid == after:
                    self.send_response(204)
                    self.send_header("X-Live", "1" if live else "0")
                    self.end_headers()
                    return
                self.send_response(200)
                self.send_header("Content-Type", "image/png")
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Frame", str(fid))
                self.send_header("X-Live", "1" if live else "0")
                self.send_header("Content-Length", str(len(png)))
                self.end_headers()
                self.wfile.write(png)
            elif self.path.split("?")[0] in ("/", "/index.html"):
                b = page.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(b)))
                self.end_headers()
                self.wfile.write(b)
            else:
                self.send_error(404)

    return Server(("127.0.0.1", port), H)


def obs_help(url, girar):
    w, h = (1448, 1072) if girar in (90, 270) else (1072, 1448)
    return f"""No OBS: Fontes → + → Navegador
  URL:     {url}
  Largura: {w}   Altura: {h}
  (desmarque "Desligar fonte quando não visível")"""


def cmd_tela(args):
    screen = Screen()
    srv = obs_server(screen, args.porta, args.girar, args.inverter, args.fundo)
    # connect once in the foreground, so the SSH password prompt (if any) shows here
    subprocess.run(ssh_cmd("true"), check=False)
    threading.Thread(target=grab_loop, args=(screen, args.fps), daemon=True).start()
    url = f"http://127.0.0.1:{args.porta}/"
    print(f"\nTransmitindo a tela do Kindle em {url}\n\n{obs_help(url, args.girar)}\n\nCtrl+C para parar.", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nparado.")


# ---------------------------------------------------------------- servir (os botões do KOReader)

CONFIG = Path.home() / ".config/kindle/servidor.json"
QUEUE = Path.home() / "Kindle/Enviar"
SENT = Path.home() / "Kindle/Enviados"


def server_config():
    try:
        c = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        c = {}
    if not c.get("token"):
        c["token"] = hashlib.sha256(os.urandom(32)).hexdigest()[:32]
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps(c, indent=1))
        CONFIG.chmod(0o600)
    c.setdefault("porta", 8766)
    c.setdefault("porta_tela", 8767)
    c.setdefault("porta_obs", 8765)
    return c


def queue_files():
    QUEUE.mkdir(parents=True, exist_ok=True)
    return sorted(p for p in QUEUE.iterdir()
                  if p.is_file() and not p.name.startswith(".") and p.suffix.lower() in BOOK_EXT)


def cmd_servir(args):
    conf = server_config()
    token = conf["token"]
    screen = Screen()
    pending = {"metas": None, "books": {}}
    lock = threading.Lock()

    def log(*a):
        print(time.strftime("%H:%M:%S"), *a, flush=True)

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def reply(self, code, body=b"", ctype="text/plain; charset=utf-8"):
            if isinstance(body, str):
                body = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def authorized(self):
            if self.headers.get("X-Token") == token:
                return True
            self.reply(403, "token errado\n")
            return False

        def body(self):
            return self.rfile.read(int(self.headers.get("Content-Length") or 0))

        def name_arg(self):
            m = re.search(r"[?&]n=([0-9a-f]+)", self.path)
            name = bytes.fromhex(m.group(1)).decode() if m else ""
            p = QUEUE / name
            return p if name and "/" not in name and p.is_file() else None

        def do_GET(self):
            if not self.authorized():
                return
            path = self.path.split("?")[0]
            if path == "/ping":
                self.reply(200, f"ok {os.uname().nodename}\n")
            elif path == "/fila":
                lines = [f"{p.name.encode().hex()}\t{p.stat().st_size}\t{p.name}" for p in queue_files()]
                self.reply(200, "".join(l + "\n" for l in lines))
            elif path == "/fila/arquivo":
                p = self.name_arg()
                if not p:
                    return self.reply(404, "não está na fila\n")
                self.reply(200, p.read_bytes(), "application/octet-stream")
            else:
                self.reply(404, "?\n")

        def do_POST(self):
            if not self.authorized():
                return
            path = self.path.split("?")[0]
            vault = ateliet_vault()
            if path == "/fila/feito":
                p = self.name_arg()
                if p:
                    SENT.mkdir(parents=True, exist_ok=True)
                    p.replace(SENT / p.name)
                    log("entregue ao Kindle:", p.name)
                self.reply(200, "ok\n")
            elif path == "/trechos/precisa":
                if not vault:
                    return self.reply(500, "não achei o vault do Ateliet no Mac\n")
                with lock:
                    pending["metas"] = parse_metadata(self.body())
                    pending["books"] = {}
                    need = books_needed(pending["metas"], vault)
                self.reply(200, "".join(p + "\n" for p in need))
            elif path == "/trechos/livro":
                kpath = bytes.fromhex(self.headers.get("X-Caminho", "")).decode()
                with lock:
                    pending["books"][kpath] = self.body()
                self.reply(200, "ok\n")
            elif path == "/trechos/exportar":
                with lock:
                    metas, books = pending["metas"], pending["books"]
                    pending["metas"], pending["books"] = None, {}
                if metas is None or not vault:
                    return self.reply(400, "mande /trechos/precisa antes\n")
                out = []
                n = export_trechos(vault, metas, books.get, log=out.append)
                for l in out:
                    log(l.strip())
                msg = f"{n} grifo(s) novo(s) no Ateliet" if n else "Nada novo para exportar."
                log("trechos:", msg)
                self.reply(200, msg + "\n" + "\n".join(l.strip() for l in out) + "\n")
            else:
                self.reply(404, "?\n")

    class Frames(socketserver.StreamRequestHandler):
        def handle(self):
            head = self.rfile.readline().decode(errors="replace").split()
            if len(head) != 6 or head[0] != "KINDLE-FB" or head[1] != token:
                return
            try:
                feed_stream(screen, self.rfile, head)
            except (OSError, ValueError, zlib.error) as e:
                log("tela:", e)
            finally:
                screen.offline()
                log("transmissão da tela encerrada")

    class TCP(socketserver.ThreadingMixIn, socketserver.TCPServer):
        daemon_threads = True
        allow_reuse_address = True

    api = Server(("0.0.0.0", conf["porta"]), H)
    frames = TCP(("0.0.0.0", conf["porta_tela"]), Frames)
    servers = [frames]
    try:
        servers.append(obs_server(screen, conf["porta_obs"]))
        log(f"tela para o OBS em http://127.0.0.1:{conf['porta_obs']}/")
    except OSError:
        log(f"porta {conf['porta_obs']} ocupada (um kindle-tela aberto?): a página do OBS fica com ele")
    for s in servers:
        threading.Thread(target=s.serve_forever, daemon=True).start()
    log(f"servindo os botões do KOReader na porta {conf['porta']}; fila de livros: {QUEUE}")
    try:
        api.serve_forever()
    except KeyboardInterrupt:
        print("\nparado.")


# ---------------------------------------------------------------- main

def main():
    prog = Path(sys.argv[0]).name
    argv = sys.argv[1:]
    sub = {"kindle-enviar": "enviar", "kindle-trechos": "trechos", "kindle-tela": "tela", "kindle-servir": "servir"}.get(prog)
    if sub:
        argv = [sub, *argv]

    p = argparse.ArgumentParser(prog="kindle", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)

    e = s.add_parser("enviar", help="manda livros para o Kindle (pasta Livros)")
    e.add_argument("livros", nargs="+")
    e.add_argument("--pasta", help="subpasta dentro de Livros (ex.: Quadrinhos)")
    e.add_argument("--forcar", action="store_true", help="manda mesmo formatos desconhecidos")
    e.add_argument("--fila", action="store_true", help="só põe na fila (~/Kindle/Enviar) para o botão do KOReader")
    e.set_defaults(fn=cmd_enviar)

    t = s.add_parser("trechos", help="grifos do KOReader -> notas de livro do Ateliet")
    t.add_argument("--vault", help="vault (padrão: o último aberto no Ateliet)")
    t.add_argument("--sem-livro", action="store_true", help="não copia o arquivo do livro para o vault")
    t.add_argument("--teste", action="store_true", help="mostra o que faria, sem gravar")
    t.set_defaults(fn=cmd_trechos)

    v = s.add_parser("tela", help="transmite a tela do Kindle para o OBS")
    v.add_argument("--porta", type=int, default=8765)
    v.add_argument("--fps", type=float, default=3, help="quadros por segundo (padrão 3; e-ink não precisa de mais)")
    v.add_argument("--girar", type=int, choices=(0, 90, 180, 270), default=0, help="para ler deitado")
    v.add_argument("--inverter", action="store_true", help="inverte as cores (modo noturno)")
    v.add_argument("--fundo", default="#000000", help="cor em volta da página")
    v.set_defaults(fn=cmd_tela)

    sv = s.add_parser("servir", help="atende os botões do plugin do KOReader (rode sempre ligado)")
    sv.set_defaults(fn=cmd_servir)

    a = p.parse_args(argv)
    a.fn(a)


if __name__ == "__main__":
    main()
