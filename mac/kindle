def cmd_enviar(args):
    files = [Path(f) for f in args.livros]
    for f in files:
        if not f.is_file():
            sys.exit(f"não achei: {f}")
        if f.suffix.lower() not in BOOK_EXT and not args.forcar:
            sys.exit(f"{f.name}: formato que o KOReader não abre (use --forcar para mandar mesmo assim)")
    if args.fila or subprocess.run(ssh_cmd("true"), capture_output=True).returncode != 0:
        # Kindle asleep or away: the files wait in the queue for the "Receber livros" button
        QUEUE.mkdir(parents=True, exist_ok=True)
        for f in files:
            (QUEUE / f.name).write_bytes(f.read_bytes())
            print(f"→ na fila: {f.name}")
        print(f"O Kindle não respondeu: {len(files)} livro(s) em {QUEUE}.\n"
              "No KOReader: menu 🔧 → Kindle ↔ Mac → Receber livros do Mac.")
        return
    dest = BOOK_DIR if not args.pasta else f"{BOOK_DIR}/{args.pasta.strip('/')}"
