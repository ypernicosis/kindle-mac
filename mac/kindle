# ---------------------------------------------------------------- SSH

def host():
    h = os.environ.get("KINDLE_HOST")
    if not h:
        f = Path.home() / ".config/kindle/host"
        h = f.read_text().strip() if f.exists() else DEFAULT_HOST
    return h


def ssh_cmd(remote, *, batch=False):
    # One master connection per run: the password (if any) is asked once.
    cp = f"/tmp/kindle-ssh-{os.getuid()}-%C"
    opts = ["-o", "ControlMaster=auto", "-o", f"ControlPath={cp}", "-o", "ControlPersist=120",
            "-o", "ConnectTimeout=8", "-o", "StrictHostKeyChecking=accept-new", "-o", "ServerAliveInterval=10"]
    if batch:
        opts += ["-o", "BatchMode=yes"]
    return ["ssh", *opts, f"root@{host()}", remote]


def ssh(remote, *, input=None, check=True):
    r = subprocess.run(ssh_cmd(remote), input=input, capture_output=True)
    if check and r.returncode != 0:
        msg = r.stderr.decode(errors="replace").strip()
        if "timed out" in msg or "No route" in msg or "Host is down" in msg:
            msg += "\n  O Kindle está acordado e no Wi-Fi? (o Wi-Fi desliga quando ele dorme)"
        sys.exit(f"erro no Kindle: {msg}")
    return r.stdout


