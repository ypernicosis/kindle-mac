# ---------------------------------------------------------------- Lua (metadata.*.lua do KOReader)

class Lua:
    """Reads the tables KOReader writes (frontend/dump.lua)."""

    def __init__(self, s):
        self.s, self.i = s, 0

    def ws(self):
        s, n = self.s, len(self.s)
        while self.i < n:
            c = s[self.i]
            if c in " \t\r\n,;":
                self.i += 1
            elif s.startswith("--", self.i):
                j = s.find("\n", self.i)
                self.i = n if j < 0 else j + 1
            else:
                break

    def value(self):
        self.ws()
        s, c = self.s, self.s[self.i]
        if c == "{":
            return self.table()
        if c in "\"'":
            return self.string()
        for word, v in (("true", True), ("false", False), ("nil", None)):
            if s.startswith(word, self.i):
                self.i += len(word)
                return v
        m = re.compile(r"-?(?:0x[0-9a-fA-F]+|\d+\.?\d*(?:[eE][-+]?\d+)?|\.\d+(?:[eE][-+]?\d+)?|inf|nan)").match(s, self.i)
        if not m:
            raise ValueError(f"lua: inesperado em {self.i}: {s[self.i:self.i + 20]!r}")
        self.i = m.end()
        t = m.group()
        if "x" in t:
            return int(t, 16)
        return float(t) if any(ch in t for ch in ".eEn") else int(t)

    def string(self):
        q, s = self.s[self.i], self.s
        self.i += 1
        out = []
        while True:
            c = s[self.i]
            if c == q:
                self.i += 1
                # the text is read byte for byte (latin-1); strings are UTF-8
                return "".join(out).encode("latin-1", "replace").decode("utf-8", "replace")
            if c == "\\":
                self.i += 1
                e = s[self.i]
                if e.isdigit():
                    m = re.compile(r"\d{1,3}").match(s, self.i)
                    out.append(chr(int(m.group())))
                    self.i = m.end()
                    continue
                out.append({"n": "\n", "t": "\t", "r": "\r", "a": "\a", "b": "\b", "f": "\f", "v": "\v", "\n": "\n"}.get(e, e))
                self.i += 1
                continue
            out.append(c)
            self.i += 1

    def table(self):
        self.i += 1
        d, arr = {}, []
        while True:
            self.ws()
            if self.s[self.i] == "}":
                self.i += 1
                break
            if self.s[self.i] == "[":
                self.i += 1
                k = self.value()
                self.ws()
                assert self.s[self.i] == "]"
                self.i += 1
                self.ws()
                assert self.s[self.i] == "="
                self.i += 1
                d[k] = self.value()
            else:
                m = re.compile(r"([A-Za-z_]\w*)\s*=").match(self.s, self.i)
                if m:
                    self.i = m.end()
                    d[m.group(1)] = self.value()
                else:
                    arr.append(self.value())
        for n, v in enumerate(arr, 1):
            d[n] = v
        if d and all(isinstance(k, int) for k in d) and sorted(d) == list(range(1, len(d) + 1)):
            return [d[k] for k in sorted(d)]
        return d

    @classmethod
    def load(cls, text):
        p = cls(text)
        p.ws()
        if p.s.startswith("return", p.i):
            p.i += len("return")
        return p.value()


# ---------------------------------------------------------------- trechos -> Ateliet

COLORS = {"yellow": "amarelo", "orange": "amarelo", "gray": "amarelo", "red": "rosa", "purple": "rosa",
          "green": "verde", "olive": "verde", "cyan": "azul", "blue": "azul"}
ATELIET_READS = {".epub", ".pdf", ".cbz", ".cbr", ".cb7", ".cbt"}
OPEN = "%% ateliet:leitor"


def ateliet_vault():
    f = Path.home() / "Library/Application Support/ateliet/ateliet.json"
    try:
        return Path(json.loads(f.read_text())["last"])
    except (OSError, ValueError, KeyError):
        return None


def clean_name(s):
    # as core/src/reader/marks.rs clean_name
    c = "".join(ch for ch in s if ch not in '/\\:*?"<>|#^[]\n\r').strip()[:90].strip().rstrip(".")
    return c or "Livro"


def yaml_str(v):
    if re.fullmatch(r"[\wÀ-ɏ][\wÀ-ɏ .,()'’-]*", v) and not v.endswith(" ") and ": " not in v:
        return v
    return "'" + v.replace("'", "''") + "'"


METADATA_SCRIPT = (
    'find /mnt/us -path /mnt/us/koreader/data -prune -o -path "*.sdr/metadata.*.lua" -print 2>/dev/null'
    ' | while IFS= read -r f; do printf "\\n@@KINDLE-FILE@@ %s\\n" "$f"; cat "$f"; done'
)


def fetch_metadata():
    """{path on the Kindle: metadata table} for every book with annotations."""
    return parse_metadata(ssh(METADATA_SCRIPT))


def parse_metadata(raw):
    """The metadata files, as METADATA_SCRIPT prints them."""
    raw = raw.decode("latin-1")
    out = {}
    for chunk in raw.split("\n@@KINDLE-FILE@@ ")[1:]:
        path, _, body = chunk.partition("\n")
        path = path.encode("latin-1").decode("utf-8", "replace")
        try:
            t = Lua.load(body)
        except (ValueError, IndexError, AssertionError) as e:
            print(f"  aviso: não li {path}: {e}", file=sys.stderr)
            continue
        if isinstance(t, dict):
            out[path] = t
    return out


def annotations(meta):
    """KOReader's highlights and notes, new format (annotations) or old (highlight)."""
    anns = meta.get("annotations")
    if isinstance(anns, list):
        return [a for a in anns if isinstance(a, dict) and a.get("text") and a.get("pos0") is not None]
    out = []
    for page, items in (meta.get("highlight") or {}).items():
        for h in (items.values() if isinstance(items, dict) else items or []):
            if isinstance(h, dict) and h.get("text"):
                h = dict(h)
                h.setdefault("pageno", page if isinstance(page, int) else None)
                out.append(h)
    return out


def book_path_on_kindle(sdr_meta_path, meta):
    p = meta.get("doc_path")
    if p:
        return p
    d = sdr_meta_path.rsplit("/", 1)[0]
    ext = sdr_meta_path.rsplit("metadata.", 1)[1][:-4]
    return d[:-4] + "." + ext


def mark_id(a):
    h = hashlib.sha1(f"{a.get('datetime', '')}|{a.get('text', '')}".encode()).hexdigest()
    return "g-k" + h[:6]


def callout(color, label, text, note, mid):
    s = f"> [!grifo|{color}] {label}".rstrip() + "\n"
    for l in text.splitlines() or [""]:
        s += f"> {l}\n"
    if note.strip():
        s += ">\n"
        for i, l in enumerate(note.strip().splitlines()):
            s += ("> Nota: " if i == 0 else "> ") + l + "\n"
    return s + f"\n^{mid}\n"


def find_book_note(vault, rel_file, title):
    folder = vault / "Livros"
    if not folder.is_dir():
        return None
    base = rel_file.rsplit("/", 1)[-1] if rel_file else None
    cands = sorted(folder.rglob("*.md"), key=lambda p: p.name != f"{clean_name(title)}.md")
    for p in cands:
        try:
            t = p.read_text(encoding="utf-8")
        except OSError:
            continue
        m = re.match(r"﻿?---\n(.*?)\n---", t, re.S)
        if not m or not re.search(r"^leitor:\s*livro\s*$", m.group(1), re.M):
            continue
        a = re.search(r"^arquivo:\s*(.+)$", m.group(1), re.M)
        if a and rel_file:
            v = a.group(1).strip().strip("'\"").replace("''", "'")
            v = v.removeprefix("[[").removesuffix("]]").split("|")[0]
            if v == rel_file or ("/" not in v and v == base):
                return p
        elif not rel_file and p.name == f"{clean_name(title)}.md":
            return p
    return None


def locate_in_vault(vault, name):
    for p in vault.rglob(name):
        if ".obsidian" not in p.parts and p.is_file():
            return p
    return None


def trechos_state(vault):
    try:
        return json.loads((vault / ".obsidian/ateliet/kindle-trechos.json").read_text())
    except (OSError, ValueError):
        return {"exportados": []}


def books_with_new_marks(metas, vault):
    """(path on the Kindle, meta, new annotations) of each book with something to export."""
    done = set(trechos_state(vault)["exportados"])
    for mpath, meta in sorted(metas.items()):
        fresh = [a for a in annotations(meta) if mark_id(a) not in done]
        if fresh:
            yield book_path_on_kindle(mpath, meta), meta, fresh


def books_needed(metas, vault):
    """Books with new highlights that the Ateliet can open but the vault doesn't have."""
    out = []
    for kpath, _, _ in books_with_new_marks(metas, vault):
        fname = kpath.rsplit("/", 1)[-1]
        if "." + fname.rsplit(".", 1)[-1].lower() in ATELIET_READS and not locate_in_vault(vault, fname):
            out.append(kpath)
    return out


def cmd_trechos(args):
    vault = Path(args.vault).expanduser() if args.vault else ateliet_vault()
    if not vault or not vault.is_dir():
        sys.exit("não achei o vault do Ateliet; use --vault CAMINHO")
    print(f"lendo os grifos do Kindle ({host()})…", flush=True)
    metas = fetch_metadata()
    get_book = None if args.sem_livro else (lambda kpath: ssh(f"cat {shlex.quote(kpath)}"))
    total = export_trechos(vault, metas, get_book, teste=args.teste, log=print)
    print(f"pronto: {total} grifo(s) novo(s)" if total else "nada novo para exportar")


def export_trechos(vault, metas, get_book, teste=False, log=print):
    """Writes the new highlights into the book notes; returns how many.
    get_book(path on the Kindle) gives a book's bytes (None: don't copy books)."""
    state = trechos_state(vault)
    done = set(state["exportados"])
    total_new = 0
    for kpath, meta, fresh in books_with_new_marks(metas, vault):
        props = meta.get("doc_props") or {}
        fname = kpath.rsplit("/", 1)[-1]
        title = (props.get("title") or "").strip() or fname.rsplit(".", 1)[0]
        author = (props.get("authors") or "").replace("\n", ", ").strip()
        ext = "." + fname.rsplit(".", 1)[-1].lower()

        # the book file in the vault, so "Abrir no Leitor" works
        rel_file = ""
        if ext in ATELIET_READS:
            found = locate_in_vault(vault, fname)
            data = get_book(kpath) if not found and get_book and not teste else None
            if data:
                dest = vault / "Livros/Arquivos" / fname
                dest.parent.mkdir(parents=True, exist_ok=True)
                log(f"  livro copiado para o vault: {dest.relative_to(vault)}")
                dest.write_bytes(data)
                found = dest
            if found:
                rel_file = found.relative_to(vault).as_posix()

        note = find_book_note(vault, rel_file, title)
        if note is None:
            note = vault / "Livros" / f"{clean_name(title)}.md"
            n = 2
            while note.exists():
                note = vault / "Livros" / f"{clean_name(title)} ({n}).md"
                n += 1
            fm = ["---", "leitor: livro", f"titulo: {yaml_str(title)}"]
            if author:
                fm.append(f"autor: {yaml_str(author)}")
            if rel_file:
                fm.append(f"arquivo: '[[{rel_file.replace(chr(39), chr(39) * 2)}]]'")
            fm.append(f"criado: {datetime.date.today().isoformat()}")
            fm.append("---")
            body = f"\n# {title}\n\n" + (f"[[{rel_file}|Abrir no Leitor]]\n\n" if rel_file else "")
            text = "\n".join(fm) + "\n" + body
        else:
            text = note.read_text(encoding="utf-8")

        # split off the data block
        data = {"v": 1, "marks": {}}
        a = text.find(OPEN)
        if a >= 0:
            e = text.find("%%", a + len(OPEN))
            try:
                data = json.loads(text[a + len(OPEN):e].strip() or "{}")
            except ValueError:
                pass
            data.setdefault("marks", {})
            end = e + 2 + (1 if text[e + 2:e + 3] == "\n" else 0)
            text = text[:a] + text[end:]
        text = text.rstrip("\n") + "\n\n"

        for ann in sorted(fresh, key=lambda x: (x.get("pageno") or 0, x.get("datetime") or "")):
            mid = mark_id(ann)
            color = COLORS.get((ann.get("color") or "").lower(), "amarelo")
            pageno = ann.get("pageno") or (ann.get("page") if isinstance(ann.get("page"), int) else None)
            chap_title = (ann.get("chapter") or "").strip()
            label = " · ".join(x for x in (chap_title, f"p. {pageno}" if pageno else "") if x)
            txt = ann["text"].strip()
            note_txt = (ann.get("note") or "").strip()
            loc = {"arquivo": rel_file, "citacao": {"exato": " ".join(txt.split())[:300]}}
            m = re.search(r"DocFragment\[(\d+)\]", str(ann.get("page") or ann.get("pos0") or ""))
            if m:
                loc["capitulo"] = int(m.group(1)) - 1
            elif isinstance(ann.get("page"), int) and ext in (".pdf", ".cbz", ".cbr", ".cb7", ".cbt"):
                loc["pagina"] = ann["page"]
            created = (ann.get("datetime") or "").replace(" ", "T")[:16]
            text += callout(color, label, txt, note_txt, mid) + "\n"
            data["marks"][mid] = {"local": loc, "fim": 0, "cor": color, "nota": note_txt,
                                  "criado": created, "texto": txt, "rotulo": label}
            done.add(mid)

        text += OPEN + "\n" + json.dumps(data, ensure_ascii=False, separators=(",", ":")) + "\n%%\n"
        if teste:
            log(f"  [teste] {note.relative_to(vault)}: +{len(fresh)}")
        else:
            note.parent.mkdir(parents=True, exist_ok=True)
            tmp = note.with_suffix(".md.tmp")
            tmp.write_text(text, encoding="utf-8")
            tmp.replace(note)
            log(f"  {note.relative_to(vault)}: +{len(fresh)} grifo(s)")
        total_new += len(fresh)

    if not teste and total_new:
        state["exportados"] = sorted(done)
        state["ultimo"] = datetime.datetime.now().isoformat(timespec="seconds")
        state_f = vault / ".obsidian/ateliet/kindle-trechos.json"
        state_f.parent.mkdir(parents=True, exist_ok=True)
        state_f.write_text(json.dumps(state, ensure_ascii=False, indent=1))
    return total_new


